# Environment
.env
*.pyc
__pycache__/

# Virtual environment
.venv/

# Data (user-specific, not committed)
data/*
!data/.gitkeep

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Sudo password (never commit)
.sudo_pass
session.py.bak

# Google API credentials (never commit)
google_credentials.json
google_token.json
gmail_token.json

# TLS certificates and private keys, e.g. Tailscale Funnel (never commit)
*.crt
*.key
*.pem

# Editor / runtime backup files (never commit)
*.bak
*.bak.*

# MCP server config: may hold a GitHub PAT (only mcp_servers.json.example is committed)
mcp_servers.json

# Any OAuth / API token JSON (broader than the named google/gmail tokens above)
*token*.json

# Atomic-write scratch files: may briefly contain secrets mid-write
*.tmp

# Node dependencies and Remotion render artifacts (reinstall via npm; never commit)
node_modules/
.remotion/
skills/remotion/render-engine/out/

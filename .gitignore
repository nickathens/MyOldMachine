# Environment
.env
*.pyc
__pycache__/

# Virtual environment
.venv/

# Data (user-specific, not committed)
data/*
!data/.gitkeep

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Sudo password (never commit)
.sudo_pass
session.py.bak

# Google API credentials (never commit)
google_credentials.json
google_token.json
gmail_token.json

# TLS certificates and private keys, e.g. Tailscale Funnel (never commit)
*.crt
*.key
*.pem

# Editor / runtime backup files (never commit)
*.bak
*.bak.*

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.myoldmachine.heartbeat</string>

    <!-- heartbeat.py loads {{WORKING_DIR}}/.env itself, so this does not need
         to source the env file the way the bot and Mini App agents do. -->
    <key>ProgramArguments</key>
    <array>
        <string>{{PYTHON}}</string>
        <string>{{WORKING_DIR}}/utils/heartbeat.py</string>
        <string>--require-service</string>
        <string>{{BOT_LABEL}}</string>
    </array>

    <key>WorkingDirectory</key>
    <string>{{WORKING_DIR}}</string>

    <!-- One shot on an interval. No KeepAlive: the script exits after each
         ping, and KeepAlive would relaunch it in a tight loop. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StartInterval</key>
    <integer>{{INTERVAL_SEC}}</integer>

    <key>StandardOutPath</key>
    <string>{{LOG_DIR}}/heartbeat.launchd.log</string>

    <key>StandardErrorPath</key>
    <string>{{LOG_DIR}}/heartbeat.launchd.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>PATH</key>
        <string>{{VENV_BIN}}:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/local/sbin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>{{HOME}}</string>
    </dict>
</dict>
</plist>

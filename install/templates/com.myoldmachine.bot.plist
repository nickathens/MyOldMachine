<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.myoldmachine.bot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>set -a; source {{ENV_FILE}}; set +a; exec {{PYTHON}} {{BOT_PY}}</string>
    </array>

    <key>WorkingDirectory</key>
    <string>{{WORKING_DIR}}</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <!-- Must NOT be {{LOG_DIR}}/bot.log: bot.py owns that path via a
         RotatingFileHandler. launchd holds this file open for the process
         lifetime, so on rollover it would keep appending to the renamed
         inode (bot.log.1) while Python wrote to a fresh bot.log, and
         backupCount would eventually unlink the inode still being written. -->
    <key>StandardOutPath</key>
    <string>{{LOG_DIR}}/bot.launchd.log</string>

    <key>StandardErrorPath</key>
    <string>{{LOG_DIR}}/bot.launchd.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>PATH</key>
        <string>{{VENV_BIN}}:{{CLI_BIN_PATHS}}/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/local/sbin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>{{HOME}}</string>
    </dict>
</dict>
</plist>

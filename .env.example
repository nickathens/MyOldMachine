# === Required ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# === LLM Provider ===
# Options: claude, codex, claude-api, openai, deepseek, grok, kimi, minimax,
#          gemini, ollama, ollama-cloud, openrouter
#
# "claude" (default): Claude Code CLI with full tool-use (bash, files, web)
#   - Requires `claude` CLI installed: npm install -g @anthropic-ai/claude-code
#   - Then run: claude auth login
#   - No API key needed. This is how the bot controls the machine.
#
# "codex": OpenAI Codex CLI with full tool-use (parallel to Claude Code)
#   - Requires `codex` CLI installed: npm install -g @openai/codex
#   - Then run: codex login (uses ChatGPT Plus/Pro/Business/Edu/Enterprise plan)
#   - For headless / no ChatGPT plan: set LLM_API_KEY to an OpenAI API key
#
# "claude-api": Anthropic API directly (text-only, no tool-use)
#   - Requires LLM_API_KEY
#   - Good for cheaper/simpler chat without machine control
#
# All API providers (openai, deepseek, grok, gemini, openrouter) have tool-use
# via function calling. Ollama is free and local — no API key needed.
#
# Edits to this file apply live: the bot re-reads .env before each turn, so
# changing LLM_PROVIDER / LLM_MODEL / LLM_EFFORT here (or from the Mini App)
# needs no restart. Startup-only settings (TELEGRAM_BOT_TOKEN, WEBHOOK_PORT)
# still require one.
#
LLM_PROVIDER=claude
LLM_MODEL=claude-sonnet-5-5
LLM_API_KEY=

# Reasoning effort for the Claude CLI provider (low, medium, high, xhigh, max).
# Higher = deeper internal reasoning before each reply, at the cost of latency
# and a larger share of your 5-hour plan budget. Default: max.
LLM_EFFORT=max

# Model for background Claude CLI work (conversation compaction). These runs
# are summarization, not chat, so they default to Haiku instead of silently
# billing at the CLI's default premium model. Uncomment to override.
# BACKGROUND_MODEL=claude-haiku-4-5-20251001

# For Codex CLI (uses your ChatGPT plan, no API key needed):
# LLM_PROVIDER=codex
# LLM_MODEL=gpt-6.1-sol
# LLM_API_KEY=
# Also available: gpt-6-astra, gpt-6-luna, gpt-6-sol, gpt-5.6-sol, gpt-5.6-terra, gpt-5.6-luna
# (API ids such as gpt-5.4 or gpt-5.4-mini are refused on a ChatGPT plan;
#  gpt-5.5 retires from Codex on 2026-10-14; gpt-6.1-sol needs Codex CLI 0.159.0+.)
# Run `codex login` after install. For headless: set LLM_API_KEY to an OpenAI key.

# For Ollama (local, free):
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1:8b
# LLM_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# For OpenAI (the gpt-5.6 alias runs GPT-5.6 Sol):
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-5.6
# LLM_API_KEY=sk-...
# Also available: gpt-6-astra, gpt-6-luna, gpt-6-sol, gpt-5.6-terra, gpt-5.6-luna, gpt-5.5, gpt-5.4, gpt-5.4-mini, gpt-4.1, gpt-4.1-mini
# (gpt-6-luna and gpt-6-sol run with reasoning off here: Chat Completions takes
#  tools from them only that way. gpt-6.1-sol and gpt-5.5-pro take no tools on
#  Chat Completions at all, so they cannot drive this bot.)

# For OpenRouter (many models, one API key — free models available):
# LLM_PROVIDER=openrouter
# LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# LLM_API_KEY=sk-or-...
# Free model IDs end with :free. ~14 free models with tool-use support.
# Other free options: nvidia/nemotron-3-ultra-550b-a55b:free, thinkingmachines/inkling:free, google/gemma-4-31b-it:free

# For DeepSeek V4.1 Flash (very cheap — $0.30/$1.20 per MTok, half off-peak, 1M ctx, vision):
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-flash
# LLM_API_KEY=sk-...
# Also available: deepseek-v4-pro (text only)

# For xAI Grok ($25 free credits on signup):
# LLM_PROVIDER=grok
# LLM_MODEL=grok-4.3
# LLM_API_KEY=...
# Also: grok-4.7, grok-4.6, grok-4.5, grok-build-0.1,
#       grok-4.20-0309-non-reasoning, grok-4.20-0309-reasoning,
#       grok-4.20-multi-agent-0309
# Note: grok-4-1-fast-*, grok-4-0709, grok-code-fast-1, grok-3-mini retired
#       2026-05-15; requests to those slugs now redirect to grok-4.3 (or
#       grok-build-0.1) and are billed at that model's rate.

# For Moonshot Kimi (multimodal, 256K context, 1M on K3):
# LLM_PROVIDER=kimi
# LLM_MODEL=kimi-k2.7-code
# LLM_API_KEY=...
# Also: kimi-k2.7-code-highspeed, kimi-k3 (after a $1 top-up), kimi-k2.6

# For MiniMax (frontier coding, multimodal, very cheap — $0.30/$1.20 per MTok):
# LLM_PROVIDER=minimax
# LLM_MODEL=MiniMax-M3
# LLM_API_KEY=...
# Also: MiniMax-M3.1-Flash-Preview (M Plan subscription key only), MiniMax-M2.7, MiniMax-M2.7-highspeed

# For Z.ai GLM (open-weights flagship, 1M context, $1.40/$4.40 per MTok):
# LLM_PROVIDER=zai
# LLM_MODEL=glm-5.3
# LLM_API_KEY=...
# Also: glm-5.3-flash and glm-5.3-flashx (cheap, vision), glm-5.2. Aliases accepted: glm, zhipu. Key at z.ai.

# For Google Gemini (free tier on every Flash model; your limits are in AI Studio):
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.8-flash
# LLM_API_KEY=...
# Also: gemini-3.7-flash, gemini-3.6-flash, gemini-3.5-flash, gemini-3.5-flash-lite, gemini-3.1-pro-preview (paid only)

# === Security ===
# Comma-separated Telegram user IDs allowed to use the bot (empty = nobody, must configure during setup)
ALLOWED_USERS=

# === Personalization ===
# Bot display name
BOT_NAME=MyOldMachine

# Timezone for scheduling (IANA format)
TIMEZONE=UTC

# === Advanced ===
# Webhook server port (0 to disable, use polling)
WEBHOOK_PORT=0

# Local Telegram Bot API (for >50MB upload / >20MB download, optional)
# When enabled, the installer compiles tdlib/telegram-bot-api from source
# and registers it as a system service running on localhost:8081.
# Get api_id and api_hash from https://my.telegram.org (free, 2 min).
# TELEGRAM_API_BASE=http://localhost:8081
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=

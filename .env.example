# === Required ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# === LLM Provider ===
# Options: claude, codex, claude-api, openai, deepseek, grok, kimi, minimax,
#          gemini, ollama, ollama-cloud, openrouter
#
# "claude" (default): Claude Code CLI with full tool-use (bash, files, web)
#   - Requires `claude` CLI installed: npm install -g @anthropic-ai/claude-code
#   - Then run: claude auth login
#   - No API key needed. This is how the bot controls the machine.
#
# "codex": OpenAI Codex CLI with full tool-use (parallel to Claude Code)
#   - Requires `codex` CLI installed: npm install -g @openai/codex
#   - Then run: codex login (uses ChatGPT Plus/Pro/Business/Edu/Enterprise plan)
#   - For headless / no ChatGPT plan: set LLM_API_KEY to an OpenAI API key
#
# "claude-api": Anthropic API directly (text-only, no tool-use)
#   - Requires LLM_API_KEY
#   - Good for cheaper/simpler chat without machine control
#
# All API providers (openai, deepseek, grok, gemini, openrouter) have tool-use
# via function calling. Ollama is free and local — no API key needed.
#
LLM_PROVIDER=claude
LLM_MODEL=claude-sonnet-4-6
LLM_API_KEY=

# Reasoning effort for the Claude CLI provider (low, medium, high, xhigh, max).
# Higher = deeper internal reasoning before each reply, at the cost of latency
# and a larger share of your 5-hour plan budget. Default: max.
LLM_EFFORT=max

# Model for background Claude CLI work (conversation compaction). These runs
# are summarization, not chat, so they default to Haiku instead of silently
# billing at the CLI's default premium model. Uncomment to override.
# BACKGROUND_MODEL=claude-haiku-4-5-20251001

# For Codex CLI (uses your ChatGPT plan, no API key needed):
# LLM_PROVIDER=codex
# LLM_MODEL=gpt-5.5
# LLM_API_KEY=
# Also available: gpt-5.5-pro, gpt-5.4, gpt-5.4-mini, gpt-5.3-codex
# Run `codex login` after install. For headless: set LLM_API_KEY to an OpenAI key.

# For Ollama (local, free):
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1:8b
# LLM_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# For OpenAI (GPT-5.5 is latest, April 2026):
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-5.5
# LLM_API_KEY=sk-...
# Also available: gpt-5.5-pro, gpt-5.4-pro, gpt-5.4, gpt-5.4-mini, gpt-5.4-nano, gpt-5.3-codex, gpt-5, gpt-5-nano, gpt-4.1, gpt-4.1-mini, o3, o3-pro

# For OpenRouter (many models, one API key — free models available):
# LLM_PROVIDER=openrouter
# LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# LLM_API_KEY=sk-or-...
# Free model IDs end with :free. ~15 free models with tool-use support.
# Other free options: qwen/qwen3-coder:free, openai/gpt-oss-120b:free, inclusionai/ring-2.6-1t:free

# For DeepSeek V4 (extremely cheap — $0.14/$0.28 per MTok, 1M ctx):
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-v4-flash
# LLM_API_KEY=sk-...
# Also available: deepseek-v4-pro, deepseek-chat (V3.2 alias), deepseek-reasoner (thinking mode)

# For xAI Grok ($25 free credits on signup):
# LLM_PROVIDER=grok
# LLM_MODEL=grok-4.3
# LLM_API_KEY=...
# Also: grok-4-1-fast-non-reasoning, grok-4-1-fast-reasoning,
#       grok-4.20-0309-non-reasoning, grok-4.20-0309-reasoning,
#       grok-4.20-multi-agent-0309
# Note: grok-4-0709, grok-code-fast-1, grok-3-mini retired 2026-05-15;
#       requests to those slugs now redirect to grok-4.3.

# For Moonshot Kimi (multimodal, 256K context):
# LLM_PROVIDER=kimi
# LLM_MODEL=kimi-k2.6
# LLM_API_KEY=...
# Also: kimi-k2-thinking, kimi-k2-0905-preview (both retire 2026-05-25)

# For MiniMax (strong reasoning, very cheap — $0.30/$1.20 per MTok):
# LLM_PROVIDER=minimax
# LLM_MODEL=MiniMax-M2.7
# LLM_API_KEY=...
# Also: MiniMax-M2.7-highspeed (faster), MiniMax-M2.5 (vision)

# For Z.ai GLM (open-weights flagship, usable 1M context, $1.40/$4.40 per MTok):
# LLM_PROVIDER=zai
# LLM_MODEL=glm-5.2
# LLM_API_KEY=...
# Also: glm-5v-turbo (vision). Aliases accepted: glm, zhipu. Key at z.ai.

# For Google Gemini (free tier: 10 RPM / 250 RPD for Flash Preview):
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3-flash-preview
# LLM_API_KEY=...
# Also: gemini-3.1-pro-preview, gemini-3.1-flash-lite-preview, gemini-2.5-pro, gemini-2.5-flash

# === Security ===
# Comma-separated Telegram user IDs allowed to use the bot (empty = nobody, must configure during setup)
ALLOWED_USERS=

# === Personalization ===
# Bot display name
BOT_NAME=MyOldMachine

# Timezone for scheduling (IANA format)
TIMEZONE=UTC

# === Advanced ===
# Webhook server port (0 to disable, use polling)
WEBHOOK_PORT=0

# Local Telegram Bot API (for >50MB upload / >20MB download, optional)
# When enabled, the installer compiles tdlib/telegram-bot-api from source
# and registers it as a system service running on localhost:8081.
# Get api_id and api_hash from https://my.telegram.org (free, 2 min).
# TELEGRAM_API_BASE=http://localhost:8081
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=

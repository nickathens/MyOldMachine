# === Required ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# === LLM Provider ===
# Options: claude, claude-api, openai, deepseek, grok, kimi, gemini, ollama, openrouter
#
# "claude" (default): Claude Code CLI with full tool-use (bash, files, web)
#   - Requires `claude` CLI installed: npm install -g @anthropic-ai/claude-code
#   - Then run: claude login
#   - No API key needed. This is how the bot controls the machine.
#
# "claude-api": Anthropic API directly (text-only, no tool-use)
#   - Requires LLM_API_KEY
#   - Good for cheaper/simpler chat without machine control
#
# All API providers (openai, deepseek, grok, gemini, openrouter) have tool-use
# via function calling. Ollama is free and local — no API key needed.
#
LLM_PROVIDER=claude
LLM_MODEL=claude-sonnet-4-6
LLM_API_KEY=

# For Ollama (local, free):
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1:8b
# LLM_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# For OpenAI (GPT-5.4 is latest, March 2026):
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-5.4
# LLM_API_KEY=sk-...
# Also available: gpt-5-mini, gpt-5-nano, gpt-4.1, gpt-4.1-mini, gpt-4.1-nano, o4-mini

# For OpenRouter (many models, one API key — free models available):
# LLM_PROVIDER=openrouter
# LLM_MODEL=openrouter/hunter-alpha
# LLM_API_KEY=sk-or-...
# Free model IDs end with :free (or are OpenRouter-native like hunter-alpha/healer-alpha)
# Other free options: openai/gpt-oss-120b:free, qwen/qwen3-coder:free, nvidia/nemotron-3-super-120b-a12b:free

# For DeepSeek V3.2 (extremely cheap — $0.28/$0.42 per MTok):
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-...
# Also available: deepseek-reasoner (thinking mode)

# For xAI Grok ($25 free credits on signup):
# LLM_PROVIDER=grok
# LLM_MODEL=grok-4-1-fast-non-reasoning
# LLM_API_KEY=...
# Also: grok-4-1-fast-reasoning, grok-4.20-beta-0309-non-reasoning, grok-code-fast-1, grok-4-0709

# For Moonshot Kimi (multimodal, 256K context):
# LLM_PROVIDER=kimi
# LLM_MODEL=kimi-k2.5
# LLM_API_KEY=...
# Also: kimi-k2 (text+code), kimi-latest (auto-selects pricing tier)

# For Google Gemini (free tier: 10 RPM / 250 RPD for Flash):
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash
# LLM_API_KEY=...
# Also: gemini-2.5-pro, gemini-3.1-pro-preview, gemini-3-flash-preview, gemini-3.1-flash-lite-preview

# === Security ===
# Comma-separated Telegram user IDs allowed to use the bot (empty = anyone)
ALLOWED_USERS=

# === Personalization ===
# Bot display name
BOT_NAME=MyOldMachine

# Timezone for scheduling (IANA format)
TIMEZONE=UTC

# === Advanced ===
# Webhook server port (0 to disable, use polling)
WEBHOOK_PORT=0

# Local Telegram Bot API (for >20MB file uploads, optional)
# TELEGRAM_API_BASE=http://localhost:8081

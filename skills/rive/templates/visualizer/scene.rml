                </Rectangle>
                <Fill name="Fill">
                    <SolidColor colorValue="FFC9A84C" name="Accent">
                        <DataBindContext sourcePathIds="0:60-0:64" propertyKey="37"/>
                    </SolidColor>
                </Fill>
            </Shape>
            <Shape x="1100" y="930" name="Bar 9">
                <Rectangle width="36" height="120" originX="0.5" originY="1" cornerRadiusTL="8" name="Path">
                    <DataBindContext sourcePathIds="0:60-0:208" propertyKey="21" converterId="0:70"/>
                </Rectangle>
                <Fill name="Fill">
                    <SolidColor colorValue="FFC9A84C" name="Accent">
                        <DataBindContext sourcePathIds="0:60-0:64" propertyKey="37"/>
                    </SolidColor>
                </Fill>
            </Shape>
            <Shape x="1156" y="930" name="Bar 10">
                <Rectangle width="36" height="120" originX="0.5" originY="1" cornerRadiusTL="8" name="Path">
                    <DataBindContext sourcePathIds="0:60-0:209" propertyKey="21" converterId="0:70"/>
                </Rectangle>
                <Fill name="Fill">
                    <SolidColor colorValue="FFC9A84C" name="Accent">
                        <DataBindContext sourcePathIds="0:60-0:64" propertyKey="37"/>
                    </SolidColor>
                </Fill>
            </Shape>
            <Shape x="1212" y="930" name="Bar 11">
                <Rectangle width="36" height="120" originX="0.5" originY="1" cornerRadiusTL="8" name="Path">
                    <DataBindContext sourcePathIds="0:60-0:210" propertyKey="21" converterId="0:70"/>
                </Rectangle>
                <Fill name="Fill">
                    <SolidColor colorValue="FFC9A84C" name="Accent">
                        <DataBindContext sourcePathIds="0:60-0:64" propertyKey="37"/>
                    </SolidColor>
                </Fill>
            </Shape>
            <Shape x="1268" y="930" name="Bar 12">
                <Rectangle width="36" height="120" originX="0.5" originY="1" cornerRadiusTL="8" name="Path">
                    <DataBindContext sourcePathIds="0:60-0:211" propertyKey="21" converterId="0:70"/>
                </Rectangle>
                <Fill name="Fill">
                    <SolidColor colorValue="FFC9A84C" name="Accent">
                        <DataBindContext sourcePathIds="0:60-0:64" propertyKey="37"/>
                    </SolidColor>
                </Fill>
            </Shape>
        </Node>

        <!-- declared last, so it paints behind everything: a soft aura that follows the level -->
        <Shape x="960" y="400" name="Aura" id="0:22">
            <DataBindContext sourcePathIds="0:60-0:67" propertyKey="18" converterId="0:72"/>
            <Ellipse width="1100" height="1100" originX="0.5" originY="0.5" name="Path"/>
            <Fill name="Fill">
                <RadialGradient startX="0" startY="0" endX="550" endY="0" name="Gradient">
                    <GradientStop colorValue="FFC9A84C" position="0"/>
                    <GradientStop colorValue="00C9A84C" position="1"/>
                </RadialGradient>
            </Fill>
        </Shape>

        <LinearAnimation fps="60" duration="1" name="Still" id="0:80"/>
        <StateMachine name="Visualizer Machine" id="0:90">
            <StateMachineLayer name="Bind" id="0:91">
                <AnyState x="400" y="0"/>
                <ExitState x="560" y="0"/>
                <EntryState x="0" y="0"><StateTransition stateToId="0:92"/></EntryState>
                <AnimationState x="200" y="0" animationId="0:80" id="0:92"/>
            </StateMachineLayer>
        </StateMachine>
    </Artboard>

    <!-- 0..1 levels to pixels and to a scale. Clamped, so a value above 1 cannot break the layout. -->
    <DataConverterRangeMapper minInput="0" maxInput="1" minOutput="10" maxOutput="230"
                              clampLower="true" clampUpper="true" name="Level to height" id="0:70"/>
    <DataConverterRangeMapper minInput="0" maxInput="1" minOutput="1" maxOutput="1.22"
                              clampLower="true" clampUpper="true" name="Level to scale" id="0:71"/>
    <DataConverterRangeMapper minInput="0" maxInput="1" minOutput="0" maxOutput="0.35"
                              clampLower="true" clampUpper="true" name="Level to glow" id="0:72"/>


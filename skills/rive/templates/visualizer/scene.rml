                </Rectangle>
                <Fill name="Fill">
                    <SolidColor colorValue="FFC9A84C" name="Accent">
                        <DataBindContext sourcePathIds="0:60-0:64" propertyKey="37"/>
                    </SolidColor>
                </Fill>
            </Shape>
            <Shape x="988" y="930" name="Bar 7">
                <Rectangle width="36" height="120" originX="0.5" originY="1" cornerRadiusTL="8" name="Path">
                    <DataBindContext sourcePathIds="0:60-0:206" propertyKey="21" converterId="0:70"/>
                </Rectangle>
                <Fill name="Fill">
                    <SolidColor colorValue="FFC9A84C" name="Accent">
                        <DataBindContext sourcePathIds="0:60-0:64" propertyKey="37"/>

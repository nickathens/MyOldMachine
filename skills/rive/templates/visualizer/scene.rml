<Rive version="1" kind="fragment">
    <!--
      A music visualiser driven by data. Measure a track with rive_audio.py
      (12 log bands), then render with rive_render.py's curves option, which
      binds every curve named like a property, and the track as audio (the
      commands are in SKILL.md).
      Bars b1..b12 are a 12-band spectrum (0..1 each), the ring breathes with
      "low" and its glow flashes with "onset". Values are levels: the scene
      shows whatever the frame is given, so smoothing lives in rive_audio.py.
    -->
    <Artboard defaultStateMachineId="0:90" viewModelId="0:60" viewModelInstanceId="0:61" styleId="0:3"
              width="1920" height="1080" name="Visualizer" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:3"/>
        <Fill name="Background"><SolidColor colorValue="FF07080A" name="Color"/></Fill>

        <Text x="960" y="382" sizingValue="autoWidth" originX="0.5" originY="0.5" name="Title" id="0:30">
            <TextStylePaint fontSize="54" fontAssetId="0:50" familyName="Space Grotesk" styleName="Bold"
                            name="Title Style" id="0:31">
                <Fill name="Fill"><SolidColor colorValue="FFF2F2F2" name="Color"/></Fill>
                <TextStyleAxis tag="2003265652" axisValue="700" name="Weight"/>
            </TextStylePaint>
            <TextValueRun styleId="0:31" text="Track title" name="Title Run">
                <DataBindContext sourcePathIds="0:60-0:62" propertyKey="268"/>
            </TextValueRun>
        </Text>
        <Text x="960" y="444" sizingValue="autoWidth" originX="0.5" originY="0.5" opacity="0.7" name="Artist" id="0:32">
            <TextStylePaint fontSize="28" letterSpacing="2" fontAssetId="0:50" familyName="Space Grotesk"
                            styleName="Regular" name="Artist Style" id="0:33">
                <Fill name="Fill"><SolidColor colorValue="FFF2F2F2" name="Color"/></Fill>
                <TextStyleAxis tag="2003265652" axisValue="400" name="Weight"/>
            </TextStylePaint>
            <TextValueRun styleId="0:33" text="Artist" name="Artist Run">
                <DataBindContext sourcePathIds="0:60-0:63" propertyKey="268"/>
            </TextValueRun>
        </Text>

        <Shape x="960" y="400" name="Ring" id="0:20">
            <DataBindContext sourcePathIds="0:60-0:65" propertyKey="16" converterId="0:71"/>
            <DataBindContext sourcePathIds="0:60-0:65" propertyKey="17" converterId="0:71"/>
            <Ellipse width="420" height="420" originX="0.5" originY="0.5" name="Path"/>
            <Stroke thickness="8" name="Line">
                <SolidColor colorValue="FFC9A84C" name="Accent">
                    <DataBindContext sourcePathIds="0:60-0:64" propertyKey="37"/>
                </SolidColor>
            </Stroke>
        </Shape>
        <Shape x="960" y="400" name="Glow" id="0:21">
            <DataBindContext sourcePathIds="0:60-0:65" propertyKey="16" converterId="0:71"/>
            <DataBindContext sourcePathIds="0:60-0:65" propertyKey="17" converterId="0:71"/>
            <DataBindContext sourcePathIds="0:60-0:66" propertyKey="18"/>
            <Ellipse width="420" height="420" originX="0.5" originY="0.5" name="Path"/>
            <Stroke thickness="26" name="Soft">
                <SolidColor colorValue="FFC9A84C" name="Accent">
                    <DataBindContext sourcePathIds="0:60-0:64" propertyKey="37"/>
                </SolidColor>
                <Feather strength="36" name="Feather"/>
            </Stroke>
        </Shape>

        <Node name="Bars" id="0:40">
            <Shape x="652" y="930" name="Bar 1">
                <Rectangle width="36" height="120" originX="0.5" originY="1" cornerRadiusTL="8" name="Path">
                    <DataBindContext sourcePathIds="0:60-0:200" propertyKey="21" converterId="0:70"/>
                </Rectangle>
                <Fill name="Fill">
                    <SolidColor colorValue="FFC9A84C" name="Accent">
                        <DataBindContext sourcePathIds="0:60-0:64" propertyKey="37"/>
                    </SolidColor>
                </Fill>
            </Shape>
            <Shape x="708" y="930" name="Bar 2">
                <Rectangle width="36" height="120" originX="0.5" originY="1" cornerRadiusTL="8" name="Path">
                    <DataBindContext sourcePathIds="0:60-0:201" propertyKey="21" converterId="0:70"/>
                </Rectangle>
                <Fill name="Fill">
                    <SolidColor colorValue="FFC9A84C" name="Accent">
                        <DataBindContext sourcePathIds="0:60-0:64" propertyKey="37"/>
                    </SolidColor>
                </Fill>
            </Shape>
            <Shape x="764" y="930" name="Bar 3">
                <Rectangle width="36" height="120" originX="0.5" originY="1" cornerRadiusTL="8" name="Path">
                    <DataBindContext sourcePathIds="0:60-0:202" propertyKey="21" converterId="0:70"/>
                </Rectangle>
                <Fill name="Fill">
                    <SolidColor colorValue="FFC9A84C" name="Accent">
                        <DataBindContext sourcePathIds="0:60-0:64" propertyKey="37"/>
